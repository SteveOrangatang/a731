{
  "list": "Work Orders",
  "settings": {
    "versioning": true,
    "attachments": true,
    "titleUnique": true
  },
  "columns": [
    { "internalName": "Title", "displayName": "WO Number", "type": "Text", "required": true, "unique": true, "indexed": true },
    { "internalName": "WODescription", "displayName": "Description", "type": "Note", "richText": false },
    { "internalName": "WorkType", "displayName": "Work Type", "type": "Choice", "choices": ["Corrective", "Preventive", "Safety", "Service Call", "Project"] },
    { "internalName": "Priority", "displayName": "Priority", "type": "Choice", "choices": ["1 - Emergency", "2 - Urgent", "3 - Routine", "4 - Low"] },
    { "internalName": "WOStatus", "displayName": "Status", "type": "Choice", "default": "New", "choices": ["New", "Assigned", "Scheduled", "In Progress", "On Hold - Parts", "On Hold - Access", "On Hold - Other", "Completed", "Closed in GMMS", "Cancelled"] },
    { "internalName": "Location", "displayName": "Location", "type": "Text" },
    { "internalName": "AssetID", "displayName": "Asset", "type": "Text" },
    { "internalName": "Shop", "displayName": "Shop", "type": "Choice", "choices": ["HVAC", "Electrical", "Plumbing", "Carpentry", "Generator", "Grounds", "Other"] },
    { "internalName": "AssignedTech", "displayName": "Assigned To", "type": "UserMulti" },
    { "internalName": "ReportedDate", "displayName": "Reported Date", "type": "DateTime" },
    { "internalName": "DueDate", "displayName": "Due Date", "type": "DateOnly" },
    { "internalName": "ScheduledDate", "displayName": "Scheduled Date", "type": "DateOnly" },
    { "internalName": "ScheduledSlot", "displayName": "Scheduled Slot", "type": "Choice", "choices": ["AM", "PM", "All Day"] },
    { "internalName": "CompletedDate", "displayName": "Completed Date", "type": "DateTime" },
    { "internalName": "CompletionNotes", "displayName": "Completion Notes", "type": "Note", "richText": false },
    { "internalName": "LaborHours", "displayName": "Labor Hours", "type": "Number", "decimals": 1 },
    { "internalName": "PartsUsed", "displayName": "Parts Used", "type": "Note", "richText": false },
    { "internalName": "HoldReason", "displayName": "Hold Reason", "type": "Note", "richText": false },
    { "internalName": "GMMSSync", "displayName": "GMMS Sync", "type": "Choice", "default": "No Action Needed", "choices": ["No Action Needed", "Pending", "Synced"] },
    { "internalName": "SyncedBy", "displayName": "Synced By", "type": "User" },
    { "internalName": "SyncedDate", "displayName": "Synced Date", "type": "DateTime" },
    { "internalName": "IngestSource", "displayName": "Ingest Source", "type": "Choice", "choices": ["Report", "Email", "Manual"] },
    { "internalName": "LastSeenGMMS", "displayName": "Last Seen In GMMS", "type": "DateOnly" },
    { "internalName": "ReconFlag", "displayName": "Recon Flag", "type": "Boolean", "default": false }
  ],
  "views": [
    { "name": "Open Work", "default": true, "filter": "Status not in [Completed, Closed in GMMS, Cancelled]", "sort": ["Priority asc", "DueDate asc"] },
    { "name": "Sync Queue", "filter": "GMMS Sync = Pending", "sort": ["Modified asc"], "columns": ["WO Number", "Status", "Completion Notes", "Labor Hours", "Parts Used", "Assigned To", "Modified"] },
    { "name": "Recon Review", "filter": "Recon Flag = Yes AND Status not in [Completed, Closed in GMMS, Cancelled]" },
    { "name": "Today's Schedule", "filter": "Scheduled Date = [Today]", "sort": ["Shop asc", "Scheduled Slot asc"] },
    { "name": "Completed This Week", "filter": "Completed Date >= [Today]-7", "sort": ["Completed Date desc"] }
  ]
}
